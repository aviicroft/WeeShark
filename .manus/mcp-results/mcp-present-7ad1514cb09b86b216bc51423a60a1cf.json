-passive-web-security-po-muzwpzk4-10b53a85","title":"WeeShark: Passive Web Security Posture Assessment","contentKind":"slides","icon":"presentation","viewer":{"type":"addon_widget","widgetId":"studio","widgetUri":"manus-widget://manus-slides/studio/deck/weeshark-passive-web-security-po-muzwpzk4-10b53a85"},"legacySlides":{"manifestUrl":"https://manus-addon-slides.manus.im/api/v1/resource-","title":"WeeShark: Passive Web Security Posture Assessment","directory":"/home/ubuntu/manus-slides/weeshark-passive-web-security-po-muzwpzk4-10b53a85","outline":[{"id":"cover","title":"WeeShark","summary":"Introduce the project as a lightweight, passive web-security posture scanner for authorized defensive audits."},{"id":"introduction","title":"Introduction | Making posture visible","summary":"Frame the value of a repeatable, low-impact baseline across encryption, response headers, cookies, exposed services, and information disclosure."},{"id":"literature","title":"Literature review | What prior work establishes","summary":"Synthesize empirical security-header adoption research, NIST TLS implementation guidance, and OWASP recommendations on headers and SSRF defense."},{"id":"problem","title":"Problem statement | Baseline without overreach","summary":"Define the gap, research question, project objectives, intended audience, and scope boundaries for a safe first-pass assessment."},{"id":"methodology","title":"Research methodology | A deterministic audit pipeline","summary":"Describe input normalization, public-host validation, bounded probing, evidence extraction, weighted scoring, recommendations, and persistence."},{"id":"architecture","title":"System architecture | Useful checks, protected boundary","summary":"Map both frontends through the API to the shared Python engine, SQLite ledger, and PDF reporting, highlighting layered SSRF safeguards."},{"id":"scoring","title":"Measurement model | Five signals, one explainable score","summary":"Visualize the five score components and their documented weights, plus risk bands and the limits of a composite score."},{"id":"results","title":"Results & discussion | What the repository demonstrates","summary":"Report implemented capabilities and documented verification evidence, distinguish tests from real-world validation, and note evidence gaps."},{"id":"conclusion","title":"Conclusion & future scope","summary":"Summarize the contribution and recommend benchmark scans, score calibration, broader checks, and operational deployment controls."},{"id":"references","title":"References & responsible-use boundary","summary":"Provide traceable literature and project sources, then reiterate authorized-only, non-destructive use."}],"isImageSlides":false,"isPptx":false}}]},"resource_uri":"manus-resource://manus-slides/deck/weeshark-passive-web-security-po-muzwpzk4-10b53a85","widget_uri":"manus-widget://manus-slides/studio/deck/weeshark-passive-web-security-po-muzwpzk4-10b53a85","model_summary":{"project_id":"weeshark-passive-web-security-po-muzwpzk4-10b53a85","project_dir":"C:\\Users\\ajind\\OneDrive\\Documents\\GitHub\\WeeShark\\manus-slides\\weeshark-passive-web-security-po-muzwpzk4-10b53a85","active_file":"references.html","resource_uri":"manus-resource://manus-slides/deck/weeshark-passive-web-security-po-muzwpzk4-10b53a85","base_resource_uri":"manus-resource://manus-slides/deck/weeshark-passive-web-security-po-muzwpzk4-10b53a85","widget_uri":"manus-widget://manus-slides/studio/deck/weeshark-passive-web-security-po-muzwpzk4-10b53a85","base_widget_uri":"manus-widget://manus-slides/studio/deck/weeshark-passive-web-security-po-muzwpzk4-10b53a85","version_id":"v-muzwuswu-209ead08"}},"_meta":{"manus.addon.result/v1":{"schema":"manus.addon.result/v1","addonId":"manus-slides","resources":[{"schema":"manus.addon.resource/v1","accessMode":"default","addonId":"manus-slides","resourceKey":"deck","resourceId":"weeshark-passive-web-security-po-muzwpzk4-10b53a85","resourceUri":"manus-resource://manus-slides/deck/weeshark-pa